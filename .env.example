# VulnForge Lab - Environment Configuration
# Copy this file to .env and adjust as needed, or run ./docker_install.sh which
# performs package detection, .env creation, port selection and startup.
# WARNING: This project is intentionally vulnerable. Run only in isolated local environments.
# License: AGPL-3.0 only - Author: Cuma KURT <cumakurt@gmail.com>

# ─── Network ────────────────────────────────────────────────────────────────
BIND_HOST=127.0.0.1
GATEWAY_HTTP_PORT=8000
GATEWAY_HTTPS_PORT=8443
LAB_CONTROL_PORT=9100
TRUTH_API_PORT=9101
OOB_COLLECTOR_HTTP_PORT=9000
OOB_COLLECTOR_DNS_PORT=5353

# ─── WAF Profile ────────────────────────────────────────────────────────────
# Options: waf-off | waf-low | waf-high | ratelimit | flaky | waf-honeypot
WAF_PROFILE=waf-off

# ─── Vulnerability Level Filter ─────────────────────────────────────────────
# Which levels to expose: comma-separated subset of 0,1,2,3,4
# L0 = safe controls, L1 = no filter, L2 = simple filter, L3 = strong filter, L4 = WAF/multi-step
VULN_LEVELS=0,1,2,3,4

# ─── Seed ───────────────────────────────────────────────────────────────────
# Options: small | large
SEED_PROFILE=small
SEED_VALUE=42

# ─── Egress ─────────────────────────────────────────────────────────────────
# Set to true ONLY if you explicitly need outbound internet (not recommended)
ALLOW_EGRESS=false

# ─── Active Profiles ────────────────────────────────────────────────────────
# Controls which docker compose services start by default
# Options: core | full | api | infra | waf | crawl
COMPOSE_PROFILES=core   # core | full | api | infra | waf | crawl

# ─── Database Credentials (synthetic only) ──────────────────────────────────
MYSQL_ROOT_PASSWORD=vulnforge_root
MYSQL_DATABASE=vulnforge
MYSQL_USER=vulnlab
MYSQL_PASSWORD=vulnlab_pass

POSTGRES_DB=vulnforge
POSTGRES_USER=vulnlab
POSTGRES_PASSWORD=vulnlab_pass

MONGO_INITDB_ROOT_USERNAME=vulnlab
MONGO_INITDB_ROOT_PASSWORD=vulnlab_pass
MONGO_INITDB_DATABASE=vulnforge

REDIS_PASSWORD=

# ─── JWT / Auth ─────────────────────────────────────────────────────────────
# Weak secret intentionally - for JWT vulnerability testing
JWT_WEAK_SECRET=secret
JWT_RS256_KID=key1

# ─── Lab Control ────────────────────────────────────────────────────────────
LAB_CONTROL_API_KEY=lab-control-dev-key

# ─── TLS Profile ────────────────────────────────────────────────────────────
# Options: good | weak-ciphers | expired | selfsigned
TLS_PROFILE=selfsigned
